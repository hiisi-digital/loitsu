{
  "name": "@hiisi/loitsu",
  "version": "0.1.0",
  "license": "MPL-2.0",
  "exports": {
    ".": "./mod.ts",
    "./syntax": "./src/syntax.ts",
    "./macro": "./src/macro.ts",
    "./cli": "./cli/mod.ts",
    "./register": "./register.ts",
    "./preload": "./preload.ts"
  },
  "tasks": {
    "check": "deno check mod.ts cli/mod.ts register.ts preload.ts",
    "test": "deno test --allow-read --allow-env --allow-sys --allow-run --unstable-worker-options --allow-write=$TMPDIR,/tmp,/private/tmp,/var/folders,/private/var/folders",
    "lint": "deno run -A gate.ts",
    "mutate": "deno run -A tools/mutate.ts",
    "mutate:all": "deno run -A tools/mutate_all.ts",
    "bench": "deno bench --allow-read --allow-env --unstable-worker-options benches/"
  },
  "imports": {
    "@hiisi/viola": "jsr:@hiisi/viola@^0.4.0",
    "@hiisi/viola-default-lints": "jsr:@hiisi/viola-default-lints@^0.4.0",
    "@hiisi/viola-grammar-ts": "jsr:@hiisi/viola-grammar-ts@^0.4.0",
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "typescript": "npm:typescript@^5.9.2"
  },
  "publish": {
    "include": [
      "mod.ts",
      "register.ts",
      "preload.ts",
      "src/",
      "cli/",
      "README.md",
      "LICENSE",
      "deno.json"
    ]
  },
  "minimumDependencyAge": 0,
  "links": [
    "../viola",
    "../viola-default-lints",
    "../viola-grammar-ts"
  ]
}
